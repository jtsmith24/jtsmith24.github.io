---
import Layout from "@layouts/Layout.astro";
import Header from "@components/astro/Header.astro";
import Footer from "@components/astro/Footer.astro";
import FeatureCard from "@components/astro/FeatureCard.astro";
import Hr from "@components/astro/Hr.astro";
import {
  siteIntro,
  experience,
  projects,
  skills,
  education,
} from "@data/resume";

// Link the hymnal.app mention in the intro.
const [introBefore, introAfter] = siteIntro.split("hymnal.app");

const sortedProjects = projects
  .filter(project => !project.hidden)
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>
        I'm <span class="text-skin-accent">Jordan Smith</span>, a full-stack
        software engineer in Nashville.
      </h1>
      <p class="summary">
        {introBefore}<a
          href="https://hymnal.app"
          target="_blank"
          rel="noopener">hymnal.app</a
        >{introAfter}
      </p>
    </section>

    <Hr />

    <section id="experience">
      <h2>Experience</h2>
      {
        experience.map(job => (
          <article class="job">
            <h3>
              <span class="text-skin-accent">{job.company}</span>
              {job.companyNote && (
                <span class="company-note">({job.companyNote})</span>
              )}
            </h3>
            <p class="job-meta">
              {job.location} · {job.dates}
            </p>
            <ul class="roles">
              {job.roles.map(role => (
                <li>
                  <span class="font-semibold">{role.title}</span>
                  <span class="opacity-75"> · {role.dates}</span>
                  {role.note && (
                    <span class="block text-sm opacity-75">{role.note}</span>
                  )}
                </li>
              ))}
            </ul>
            <ul class="bullets">
              {job.bullets.map(bullet =>
                typeof bullet === "string" ? (
                  <li>{bullet}</li>
                ) : (
                  <li>
                    <strong>{bullet.label}.</strong> {bullet.text}
                  </li>
                )
              )}
            </ul>
          </article>
        ))
      }
    </section>

    <Hr />

    <section id="projects">
      <h2>Projects</h2>
      <ul class="grid gap-6">
        {
          sortedProjects.map(project => (
            <li>
              <FeatureCard project={project} />
            </li>
          ))
        }
      </ul>
    </section>

    <Hr />

    <section id="skills">
      <h2>Skills and education</h2>
      <dl>
        {
          skills.map(({ group, items }) => (
            <div class="skill-group">
              <dt>{group}</dt>
              <dd>{items.join(", ")}</dd>
            </div>
          ))
        }
        <div class="skill-group">
          <dt>Education</dt>
          <dd>
            {education.degree} · {education.school} · {education.year}
          </dd>
        </div>
      </dl>
    </section>
  </main>
  <Footer />

  <style>
    /* ===== Hero Section ===== */
    #hero {
      @apply pb-10 pt-8 text-center;
    }
    #hero h1 {
      @apply my-4 text-left text-3xl font-bold sm:my-8 sm:text-5xl;
    }
    #hero .summary {
      @apply mb-6 text-left leading-relaxed;
    }
    #hero .summary a {
      @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
    }

    /* ===== Content Sections ===== */
    #experience,
    #projects,
    #skills {
      @apply scroll-mt-4 pb-10 pt-12;
    }
    h2 {
      @apply pb-10 text-center text-3xl font-semibold tracking-wide;
    }

    /* ===== Experience ===== */
    .job {
      @apply mb-12 last:mb-0;
    }
    .job h3 {
      @apply text-xl font-bold;
    }
    .company-note {
      @apply ml-2 text-sm font-normal opacity-75;
    }
    .job-meta {
      @apply mb-4 text-sm opacity-75;
    }
    .roles {
      @apply mb-4 space-y-1 border-l-2 border-skin-accent pl-4;
    }
    .bullets {
      @apply list-disc space-y-3 pl-5 leading-relaxed marker:text-skin-accent;
    }

    /* ===== Skills ===== */
    .skill-group {
      @apply mb-4 sm:flex sm:gap-4;
    }
    .skill-group dt {
      @apply font-semibold text-skin-accent sm:w-48 sm:shrink-0;
    }
  </style>
</Layout>
