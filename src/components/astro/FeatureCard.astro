---
import type { Project } from "@data/resume";
import { Image } from "astro:assets";
export interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, meta, description, bullets, links, thumbnail } = project;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../images/*.{jpeg,jpg,png,PNG,gif}"
);
if (thumbnail && !images[thumbnail])
  throw new Error(
    `"${thumbnail}" does not exist in glob: "src/images/*.{jpeg,jpg,png,gif}"`
  );
---

<div
  class="flex h-full flex-col rounded-sm border border-skin-accent shadow-lg"
>
  {
    thumbnail && (
      <div class="px-6 pt-6">
        <Image
          class="w-full rounded-sm border border-skin-line"
          width="1400"
          src={images[thumbnail]()}
          alt={`Screenshot of the ${name} home page`}
        />
      </div>
    )
  }
  <div class="px-6 py-4">
    <h3 class="mb-2 text-center text-xl font-bold">{name}</h3>
    {meta && <p class="mb-4 text-center text-sm opacity-75">{meta}</p>}
    {description && <p class="mb-4">{description}</p>}
    {
      bullets && (
        <ul class="card-bullets">
          {bullets.map(bullet => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="mt-auto flex justify-center gap-4 pb-4">
    {
      links.map(link => (
        <div class="hover:scale-105">
          <a
            class="card-btn inline-block rounded-sm p-2 font-mono"
            href={link.href}
            target="_blank"
            rel="noopener"
          >
            {link.label}
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  .card-btn {
    @apply bg-skin-card-muted text-white;
  }
  .card-bullets {
    @apply mb-4 list-disc space-y-3 pl-5 marker:text-skin-accent;
  }
</style>
